{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ng-castro-join",
  "main": "src/index.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "routes": [{ "pattern": "join.family-castro.com", "custom_domain": true }],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "REPLACE_WITH_SESSIONS_KV_ID" },
    { "binding": "PROFILES", "id": "REPLACE_WITH_PROFILES_KV_ID" },
    { "binding": "JOIN_TOKENS", "id": "REPLACE_WITH_JOIN_TOKENS_KV_ID" },
    { "binding": "APPLICATIONS", "id": "REPLACE_WITH_APPLICATIONS_KV_ID" }
  ],
  "vars": {
    "SITE_ORIGINS": "https://family-castro.com,https://www.family-castro.com"
  }
}
