{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ng-castro-auth",
  "main": "src/index.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "routes": [{ "pattern": "auth.family-castro.com", "custom_domain": true }],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "d6a5a8e2401844259296c7a6877ef9f2" },
    { "binding": "PROFILES", "id": "a1169b8d86b64cf79c35a794231a556d" }
  ],
  "vars": {
    "SITE_ORIGINS": "https://family-castro.com,https://www.family-castro.com",
    "COOKIE_DOMAIN": ".family-castro.com",
    "OAUTH_REDIRECT_URI": "https://auth.family-castro.com/auth/callback",
    "CABINET_API_URL": "http://ng-api.family-castro.com:25992"
  }
}
